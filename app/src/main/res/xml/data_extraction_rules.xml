<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml: the API key and the stop cache stay on the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tminus_settings.xml" />
        <exclude domain="file" path="global_data_cache.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="global_data_cache.json" />
    </device-transfer>
</data-extraction-rules>
